# =============================================================================
# Chamba Digital - Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values.
# In production (Railway), set these via the Railway dashboard.
# =============================================================================

# --- REQUIRED ---
# JWT signing secret (min 32 chars). Generate with: openssl rand -hex 32
# Server will refuse to start without this.
JWT_SECRET="REPLACE_WITH_openssl_rand_-hex_32"

# MongoDB connection string. Required in production.
# Get from Railway Mongo plugin or MongoDB Atlas.
MONGO_PUBLIC_URL="mongodb://localhost:27017/chambadigital"

# --- AI / Chatbot ---
# Google Gemini API key for the AI chatbot
GEMINI_API_KEY=""

# --- Email / Marketing ---
# MailerLite API key (for lead capture / checklists)
MAILERLITE_API_KEY=""
MAILERLITE_GROUP_ID=""

# --- Payments (Polar.sh) ---
# Polar.sh access token (server-side)
POLAR_ACCESS_TOKEN=""
# Polar.sh webhook secret for signature verification
# Get from Polar dashboard > Webhooks > Reveal secret
POLAR_WEBHOOK_SECRET=""

# --- Admin credentials (for Super Admin panel) ---
# Defaults: admin@chamba.digital / chamba2026 (auto-seeded on first run)
ADMIN_EMAIL="admin@chamba.digital"
ADMIN_PASSWORD="chamba2026"

# --- Server ---
PORT=3000
NODE_ENV="development"
